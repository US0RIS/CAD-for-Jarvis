{
  "name": "@forgecad/desktop",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "dist:mac": "pnpm build && electron-builder --mac dmg",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "e2e": "playwright test",
    "test:web": "cross-env FORGECAD_WEB_ONLY=1 VITE_FORGECAD_ENGINE_URL=http://127.0.0.1:8765 VITE_FORGECAD_ENGINE_TOKEN=test-session VITE_FORGECAD_MODEL=qwen3.8:27b vite --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.1",
    "lucide-react": "^0.542.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.180.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.forgecad.studio",
    "productName": "ForgeCAD",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../services/forge-engine/dist",
        "to": "forge-engine",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "ForgeCAD-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ForgeCAD",
      "runAfterFinish": true
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "artifactName": "ForgeCAD-${version}-${arch}.${ext}"
    }
  }
}
